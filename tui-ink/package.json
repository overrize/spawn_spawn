{
  "name": "multi-agent-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent TUI prototype (V1 three-pane inbox) driven by Claude Code subprocesses.",
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test src/tests/smoke.test.ts src/tests/integration.test.ts src/tests/pm-hierarchy.test.ts"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
